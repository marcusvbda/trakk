APP_NAME=Trakk
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://trakk.mvbassalobre.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=trakk
DB_USERNAME=trakk
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Resend over SMTP (docs/DEPLOY.md). Leave MAIL_MAILER=log until the password is set.
MAIL_MAILER=log
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="trakk@mvbassalobre.com"
MAIL_FROM_NAME="${APP_NAME}"

# PASSPORT_PRIVATE_KEY and PASSPORT_PUBLIC_KEY are appended by bin/passport-keys (docs/DEPLOY.md, "Remote MCP").

OWNER_EMAIL=
OWNER_PASSWORD=
TELEGRAM_BOT_TOKEN=
