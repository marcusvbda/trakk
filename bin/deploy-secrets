#!/usr/bin/env bash
# Sets up CI access to the VPS, run from the owner's machine: a throwaway ed25519 key pair, public half installed on the
# VPS, private half sent to GitHub as a secret and deleted locally. Needs your current SSH access and a logged-in `gh`.
set -euo pipefail

source "$(dirname "$0")/lib/vps.sh"
load_vps_target

repo="$(cd "$PROJECT_DIR" && gh repo view --json nameWithOwner --jq .nameWithOwner)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

ssh-keygen -q -t ed25519 -N "" -C "trakk-github-deploy" -f "$workdir/key"

echo "==> Installing the public key on $VPS_USER@$VPS_HOST"
install_key='mkdir -p ~/.ssh && chmod 700 ~/.ssh && touch ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys && read -r line && { grep -qxF "$line" ~/.ssh/authorized_keys || echo "$line" >> ~/.ssh/authorized_keys; }'
{ printf 'restrict '; cat "$workdir/key.pub"; } | "${VPS_SSH[@]}" "$install_key"

echo "==> Reading the host key"
known_host_name="$VPS_HOST"
[ "$VPS_PORT" = "22" ] || known_host_name="[$VPS_HOST]:$VPS_PORT"
ssh-keygen -F "$known_host_name" 2>/dev/null | grep -v '^#' > "$workdir/known_hosts" || true
if [ -s "$workdir/known_hosts" ]; then
    echo "Using the host key your machine already trusts."
else
    echo "Host not in your known_hosts; scanning it (verify the fingerprint below)."
    ssh-keyscan -p "$VPS_PORT" -t ed25519 "$VPS_HOST" 2>/dev/null > "$workdir/known_hosts"
    [ -s "$workdir/known_hosts" ] || { echo "Could not read the host key from $VPS_HOST" >&2; exit 1; }
    ssh-keygen -lf "$workdir/known_hosts"
fi

echo "==> Sending secrets to $repo (the Trakk repository, found from $PROJECT_DIR)"
printf '%s' "$VPS_HOST" | gh secret set DEPLOY_VPS_HOST --repo "$repo"
printf '%s' "$VPS_USER" | gh secret set DEPLOY_VPS_USER --repo "$repo"
[ "$VPS_PORT" = "22" ] || printf '%s' "$VPS_PORT" | gh secret set DEPLOY_VPS_PORT --repo "$repo"
gh secret set DEPLOY_SSH_KEY --repo "$repo" < "$workdir/key"
gh secret set DEPLOY_VPS_KNOWN_HOSTS --repo "$repo" < "$workdir/known_hosts"

echo "Done. The private key was only held in a temporary directory and has been deleted."
