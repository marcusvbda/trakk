{
	frankenphp
	auto_https off
	admin off
}

# Plain HTTP on 8080: only the VPS's public Caddy reaches this port (over the trakk_edge network), and it terminates TLS.
:8080 {
	root * /app/public
	encode zstd br gzip

	# Only for files that exist: during a rolling deploy a container may not have the other release's hashes yet, and a cached 404 would keep the page blank for a year.
	@hashedAssets {
		path /build/assets/*
		file {path}
	}
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	php_server
}
